<html>
  <head>
    <meta charset='UTF-8' />
    <title>Welcome to SLUJST</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f5f7f6;
        margin: 0;
        padding: 24px;
        color: #253528;
      }

      .container {
        max-width: 640px;
        margin: auto;
        background: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
        border: 1px solid #e7ebe8;
      }

      .brand-bar {
        background: linear-gradient(135deg, #064e3b, #0f766e);
        padding: 28px 24px;
        text-align: center;
        color: #ffffff;
      }

      .logo {
        display: inline-block;
        background: #ffffff;
        color: #064e3b;
        font-weight: 800;
        letter-spacing: 4px;
        padding: 8px 14px;
        border-radius: 8px;
        margin-bottom: 14px;
      }

      .brand-bar h2 {
        margin: 0;
        font-size: 22px;
      }

      .brand-bar p {
        margin: 8px 0 0;
        font-size: 14px;
        color: #d9f4ec;
      }

      .content {
        padding: 28px;
        font-size: 15.5px;
        line-height: 1.7;
        color: #374151;
      }

      .content p {
        margin: 0 0 16px;
      }

      .highlight-box {
        background: #f8faf8;
        border-left: 4px solid #d4a017;
        padding: 16px;
        border-radius: 8px;
        margin: 20px 0;
      }

      .steps {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 16px 18px;
        margin: 20px 0;
      }

      .steps h3 {
        margin: 0 0 10px;
        color: #064e3b;
        font-size: 16px;
      }

      .steps ol {
        margin: 0;
        padding-left: 20px;
      }

      .steps li {
        margin-bottom: 8px;
      }

      .cta-button {
        display: inline-block;
        background: #d48a1f;
        color: #ffffff !important;
        padding: 13px 22px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 700;
        margin: 10px 0 22px;
      }

      .footer {
        background: #f9fafb;
        text-align: center;
        padding: 20px 24px;
        font-size: 13px;
        color: #6b7280;
        border-top: 1px solid #e5e7eb;
      }

      .footer a {
        color: #0f766e;
        font-weight: 700;
        text-decoration: none;
      }
    </style>
  </head>

  <body>
    <div class='container'>
      <div class='brand-bar'>
        <div class='logo'>SLUJST</div>
        <h2>Welcome to SLUJST</h2>
        <p>Sule Lamido University Journal of Science and Technology</p>
      </div>

      <div class='content'>
        <p>Dear <strong>{{fullName}}</strong>,</p>

        {{#if isSelfRegistered}}
          <p>
            Thank you for registering on the
            <strong>SLUJST Manuscript Management Platform</strong>. Your author
            account has been successfully created.
          </p>

          <div class='highlight-box'>
            You can now submit manuscripts, track your submissions, and follow
            updates from the editorial team.
          </div>

          <div class='steps'>
            <h3>What you can do next</h3>
            <ol>
              <li>Log in to your author dashboard.</li>
              <li>Complete your manuscript submission.</li>
              <li>Track review progress and editorial decisions.</li>
            </ol>
          </div>

          <a href='{{submitManuscriptUrl}}' class='cta-button'>Submit Manuscript</a>
        {{else}}
          <p>
            Welcome to the
            <strong>SLUJST Manuscript Management Platform</strong>.
          </p>

          {{#if roleName}}
            <div class='highlight-box'>
              You have been registered as
              <strong>{{roleName}}</strong>.
            </div>
          {{/if}}

          <p>
            You can now log in to your dashboard and begin using the platform.
          </p>

          <a href='{{loginUrl}}' class='cta-button'>Login to Dashboard</a>
        {{/if}}

        <p>
          SLUJST is a peer-reviewed, open-access journal dedicated to publishing
          high-quality research in science and technology, supporting
          interdisciplinary studies and discoveries that advance knowledge.
        </p>

        <p>
          Best regards,<br />
          <strong>SLUJST Editorial Team</strong>
        </p>
      </div>

      <div class='footer'>
        <p>&copy;
          {{year}}
          Sule Lamido University Journal of Science and Technology. All Rights
          Reserved.</p>
        <p>For inquiries, contact
          <a href='mailto:tea@slu.edu.ng'>tea@slu.edu.ng</a></p>
      </div>
    </div>
  </body>
</html>